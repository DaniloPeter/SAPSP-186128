{
  "_version": "1.58.0",
  "sap.app": {
    "id": "com.segezha.form.roll.conversion",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "title": "Регистрация преобразования рулонов",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "odata": {
        "uri": "/sap/opu/odata/sap/ZPP_218_SRV_SRV",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0",
          "defaultCountMode": "InlineRepeat",
          "useBatch": true
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "com.segezha.form.roll.conversion.view.App",
      "type": "XML",
      "async": true
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "path": "com.segezha.form.roll.conversion.view",
        "controlId": "app",
        "controlAggregation": "pages",
        "type": "View",
        "viewType": "XML",
        "async": true
      },
      "routes": [
        {
          "pattern": "",
          "name": "home",
          "target": "home"
        }
      ],
      "targets": {
        "home": {
          "name": "Home"
        }
      }
    },
    "dependencies": {
      "minUI5Version": "1.74.0",
      "libs": {
        "sap.ui.core": {},
        "sap.ui.comp": {},
        "sap.m": {},
        "sap.f": {}
      }
    },
    "contentDensities": {
      "cozy": true,
      "compact": false
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.segezha.form.roll.conversion.i18n.i18n"
        }
      },
      "": {
        "dataSource": "odata",
        "preload": true,
        "settings": {
          "odataVersion": "2.0",
          "defaultBindingMode": "TwoWay",
          "defaultCountMode": "InlineRepeat",
          "useBatch": true,
          "headers": {
            "Accept": "application/json"
          }
        }
      },
      "state": {
        "type": "sap.ui.model.json.JSONModel",
        "settings": {
          "fieldsFormat": {
            "Znewformat": "Введите число в формате 000,0",
            "Zflexdiameter": "Введите число в формате 000,0",
            "Zradius1": "Введите число в формате 000,0",
            "Zradius2": "Введите число в формате 000,0",
            "Zwaste": "Введите число в формате 000,000",
            "Zpm": "Введите число в формате 000 - 00000",
            "Zobjspeed": "Введите число в формате 000",
            "Zlengthreport": "Введите число в формате 000",
            "Zformat1": "Форматы исходных рулонов должны совпадать",
            "Zformat2": "Форматы исходных рулонов должны совпадать",
            "RollNum1": "Введенный номер рулона не присвоен ни одному материалу и партии",
            "RollNum2": "Введенный номер рулона не присвоен ни одному материалу и партии"
          },
          "requiredFields": [
            "Werks",
            "WpResource",
            "Lgort",
            "Smen",
            "Brig",
            "WpOperatingmode",
            "Zdatetime",
            "Aufnr",
            "Klishe",
            "Zprinter",
            "RollNum1",
            "Zformat1",
            "Znewformat",
            "Zpm",
            "Zlengthreport",
            "Zstamp",
            "Zflexdiameter"
          ],
          "switches": {
            "defect": false,
            "downTime": false,
            "roll": false,
            "rollEnabled": false
          },
          "valueHelps": {
            "BRIGSet": []
          },
          "tables": {
            "defect": {
              "path": "/tables/defect/items",
              "items": [],
              "requiredFields": ["Zobjdefect", "Zcommentdefect"]
            },
            "downTime": {
              "path": "/tables/downTime/items",
              "items": [],
              "requiredFields": [
                "Kurztext",
                "Auztv",
                "Auztb",
                "Zdownhours",
                "Qmtxt"
              ]
            }
          },
          "errorFields": {},
          "rollData": {
            "roll1": {
              "Material": "",
              "Charg": ""
            },
            "roll2": {
              "Material": "",
              "Charg": ""
            }
          },
          "draftData": []
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    }
  }
}
